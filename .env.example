# Google Gemini Multimodal AI Configuration (Vercel Environment Variable)
# Used by serverless /api/gemini-extract for 1-click video catalog extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Cloud Storage (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=catalog-images

# Optional Vercel Blob Token
BLOB_READ_WRITE_TOKEN=
